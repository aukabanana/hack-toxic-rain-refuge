// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  RESOURCE_TRACKER
  RESOURCE_FINDER
  SCOUT
  SURVIVOR
}

enum ResourceType {
  FOOD
  WATER
  MEDICINE
  TOOL
  FUEL
  EQUIPMENT
  OTHER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  UNKNOWN
}

enum MissionUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ZoneType {
  SAFE
  TOXIC
}

enum MarkerType {
  COMMUNITY_BASE
  RESOURCE_LOCATION
  MISSION_DESTINATION
  SAFE_AREA
  TOXIC_AREA
  DANGER_AREA
}

model User {
  id        String   @id @default(uuid())
  username  String
  password  String
  telephone String   @unique
  role      UserRole @default(SURVIVOR)

  memberships CommunityMember[]
  assignments MissionAssignment[]

  createdMarkers  MapMarker[]
  createdMissions Mission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Community {
  id   String @id @default(uuid())
  name String

  members   CommunityMember[]
  resources Resource[]
  markers   MapMarker[]
  zones     MapZone[]
  missions  Mission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommunityMember {
  id          String @id @default(uuid())
  userId      String
  communityId String

  role UserRole @default(SURVIVOR)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  missionAssignments MissionAssignment[]

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, communityId])
}

model Resource {
  id     String       @id @default(uuid())
  name   String
  type   ResourceType
  amount Float
  unit   String

  communityId String

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  relatedMissions Mission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MapZone {
  id          String    @id @default(uuid())
  name        String
  type        ZoneType
  riskLevel   RiskLevel @default(UNKNOWN)
  description String?
  geoJson     String?

  communityId String

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MapMarker {
  id          String     @id @default(uuid())
  name        String
  type        MarkerType
  latitude    Float
  longitude   Float
  description String?
  riskLevel   RiskLevel  @default(UNKNOWN)

  communityId String
  createdById String?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  missions Mission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Mission {
  id          String         @id @default(uuid())
  title       String
  riskLevel   RiskLevel      @default(UNKNOWN)
  isCompleted Boolean        @default(false)
  urgency     MissionUrgency @default(LOW)

  communityId    String
  targetMarkerId String?
  resourceId     String?
  createdById    String?

  community    Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  targetMarker MapMarker? @relation(fields: [targetMarkerId], references: [id], onDelete: SetNull)
  resource     Resource?  @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  createdBy    User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  assignments MissionAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MissionAssignment {
  id                String @id @default(uuid())
  missionId         String
  communityMemberId String
  userId            String

  mission         Mission         @relation(fields: [missionId], references: [id], onDelete: Cascade)
  communityMember CommunityMember @relation(fields: [communityMemberId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([missionId, userId])
}
